{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career OS Application Tracker",
  "type": "object",
  "required": [
    "version",
    "applications"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/application"
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "required": [
        "id",
        "vacancy_id",
        "company",
        "title",
        "url",
        "status",
        "source",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vacancy_id": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "enum": [
            "linkedin",
            "gupy",
            "company_site",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review_required",
            "ready_to_apply",
            "applied",
            "blocked",
            "withdrawn",
            "rejected",
            "interviewing",
            "offer",
            "hired"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmation": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "confirmation_page",
                "protocol",
                "application_id",
                "email",
                "other"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "job_pack_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cv_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
