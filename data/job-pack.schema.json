{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Career OS Job Pack",
  "type":"object",
  "required":["id","source","title","company","description","keywords","evidence","presentation","competencies","salary"],
  "properties":{
    "id":{"type":"string"},
    "source":{"type":"string"},
    "url":{"type":"string"},
    "title":{"type":"string"},
    "company":{"type":"string"},
    "description":{"type":"string"},
    "keywords":{"type":"array","items":{"type":"string"}},
    "evidence":{"type":"array","items":{"type":"object"}},
    "presentation":{"type":"string"},
    "competencies":{"type":"array","maxItems":3,"items":{"type":"string"}},
    "salary":{"type":"object","required":["market_low","market_high","suggested_low","suggested_high","sources","checked_at"],"properties":{"market_low":{"type":"number"},"market_high":{"type":"number"},"suggested_low":{"type":"number"},"suggested_high":{"type":"number"},"sources":{"type":"array","items":{"type":"object"}},"checked_at":{"type":"string"}}},
    "status":{"type":"string"}
  }
}
